# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

/dist/
/.wrangler/
.dev.vars*
!.dev.vars.example
# Checkout-local tool state; never publish it.
/.agents/
/.codex/
/.eval/
/outputs/
/work/
/.test-results/
*.tsbuildinfo

/docs/references-c8/

# Generated test and verification output.
/evidence/

# Social preview art generated from public/art at build time.
/public/og/art/
