{
  "name": "agent-mbti",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "wrangler dev --port 5188 --ip 127.0.0.1 --persist-to .wrangler/state",
    "deploy": "vinext build && wrangler deploy --var TURNSTILE_SITE_KEY:0x4AAAAAAFTsLRxtt_I7FWHz",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types --config wrangler.jsonc --include-runtime=false --strict-vars=false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "schema": "node scripts/export-schema.mjs",
    "verify:art": "node scripts/verify-art.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsqr": "1.4.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "zod-to-json-schema": "3.25.2"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
