{
  "$ref": "#/definitions/AgentWorkstyleSummaryV3",
  "definitions": {
    "AgentWorkstyleSummaryV3": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "3.0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "fixture",
            "observed"
          ]
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[\\p{L}\\p{N}\\p{M} _·-]+$"
        },
        "consent": {
          "type": "object",
          "properties": {
            "localAnalysisApproved": {
              "type": "boolean",
              "const": true
            },
            "aggregateUploadApproved": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "localAnalysisApproved",
            "aggregateUploadApproved"
          ],
          "additionalProperties": false
        },
        "observedPeriod": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "adequate",
                "partial",
                "insufficient"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "antigravity",
                  "cursor",
                  "chatgpt",
                  "other",
                  "unknown"
                ]
              },
              "maxItems": 7
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "web_history_unavailable",
                  "partial_window",
                  "no_artifact_inspection",
                  "no_tokscale",
                  "unattributed_runs",
                  "insufficient_records",
                  "other_sources_missing"
                ]
              },
              "maxItems": 7
            },
            "sampledSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "scope",
            "sources",
            "gaps",
            "sampledSessions"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "humanSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "automatedSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "subagentSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "userMessages": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokenSource": {
              "type": "string",
              "enum": [
                "tokscale",
                "authorized_records",
                "unavailable"
              ]
            },
            "modelUsage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "string",
                    "enum": [
                      "openai",
                      "anthropic",
                      "google",
                      "xai",
                      "deepseek",
                      "zai",
                      "other",
                      "unknown"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "family",
                  "count"
                ],
                "additionalProperties": false
              },
              "maxItems": 8
            },
            "modelUsageUnit": {
              "type": "string",
              "enum": [
                "reported_tokens",
                "sessions",
                "unknown"
              ]
            },
            "mostUsedModelFamily": {
              "type": "string",
              "enum": [
                "openai",
                "anthropic",
                "google",
                "xai",
                "deepseek",
                "zai",
                "other",
                "unknown"
              ]
            },
            "mostUsedClient": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code",
                "antigravity",
                "cursor",
                "chatgpt",
                "other",
                "unknown"
              ]
            }
          },
          "required": [
            "humanSessions",
            "automatedSessions",
            "subagentSessions",
            "userMessages",
            "inputTokens",
            "outputTokens",
            "tokenSource",
            "modelUsage",
            "modelUsageUnit",
            "mostUsedModelFamily",
            "mostUsedClient"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^T(00[1-9]|01[0-9]|02[0-4])$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "source": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "antigravity",
                  "cursor",
                  "chatgpt",
                  "other",
                  "unknown"
                ]
              },
              "context": {
                "type": "string",
                "enum": [
                  "research",
                  "build",
                  "writing",
                  "planning",
                  "support",
                  "other"
                ]
              },
              "axes": {
                "type": "object",
                "properties": {
                  "EI": {
                    "type": "string",
                    "enum": [
                      "E",
                      "I",
                      "unclear"
                    ]
                  },
                  "SN": {
                    "type": "string",
                    "enum": [
                      "S",
                      "N",
                      "unclear"
                    ]
                  },
                  "TF": {
                    "type": "string",
                    "enum": [
                      "T",
                      "F",
                      "unclear"
                    ]
                  },
                  "JP": {
                    "type": "string",
                    "enum": [
                      "J",
                      "P",
                      "unclear"
                    ]
                  }
                },
                "required": [
                  "EI",
                  "SN",
                  "TF",
                  "JP"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "date",
              "source",
              "context",
              "axes"
            ],
            "additionalProperties": false
          },
          "maxItems": 24
        },
        "usageEvidence": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "usage-level-v2"
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "task": {
                    "type": "string",
                    "pattern": "^T(00[1-9]|01[0-9]|02[0-4])$"
                  },
                  "signal": {
                    "type": "string",
                    "enum": [
                      "unchecked_adoption",
                      "retry_after_error",
                      "useful_result_verified",
                      "context_scoped",
                      "acceptance_defined",
                      "targeted_correction_verified"
                    ]
                  }
                },
                "required": [
                  "task",
                  "signal"
                ],
                "additionalProperties": false
              },
              "maxItems": 64
            }
          },
          "required": [
            "version",
            "observations"
          ],
          "additionalProperties": false
        },
        "systemEvidence": {
          "type": "object",
          "properties": {
            "automationSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "subagentSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "automationSpanDays": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "assetWriteSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "assetReuseSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "assetMaintainedAfterAutomation": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "gearKinds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                {
                  "type": "null"
                }
              ]
            },
            "filesScanned": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "filesListed": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "automationSessions",
            "subagentSessions",
            "automationSpanDays",
            "assetWriteSessions",
            "assetReuseSessions",
            "assetMaintainedAfterAutomation",
            "gearKinds",
            "filesScanned",
            "filesListed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "kind",
        "nickname",
        "consent",
        "observedPeriod",
        "coverage",
        "metrics",
        "tasks"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
