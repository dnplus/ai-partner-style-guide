{
  "$ref": "#/definitions/AgentWorkstyleSummaryV2",
  "definitions": {
    "AgentWorkstyleSummaryV2": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "2.0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "fixture",
            "observed"
          ]
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[\\p{L}\\p{N}\\p{M} _·-]+$"
        },
        "consent": {
          "type": "object",
          "properties": {
            "localAnalysisApproved": {
              "type": "boolean",
              "const": true
            },
            "aggregateUploadApproved": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "localAnalysisApproved",
            "aggregateUploadApproved"
          ],
          "additionalProperties": false
        },
        "observedPeriod": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "adequate",
                "partial",
                "insufficient"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "antigravity",
                  "cursor",
                  "chatgpt",
                  "other",
                  "unknown"
                ]
              },
              "maxItems": 7
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "web_history_unavailable",
                  "partial_window",
                  "no_artifact_inspection",
                  "no_tokscale",
                  "unattributed_runs",
                  "insufficient_records",
                  "other_sources_missing"
                ]
              },
              "maxItems": 7
            },
            "sampledSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "scope",
            "sources",
            "gaps",
            "sampledSessions"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "humanSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "automatedSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "subagentSessions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "userMessages": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokenSource": {
              "type": "string",
              "enum": [
                "tokscale",
                "authorized_records",
                "unavailable"
              ]
            },
            "modelUsage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "string",
                    "enum": [
                      "openai",
                      "anthropic",
                      "google",
                      "xai",
                      "deepseek",
                      "zai",
                      "other",
                      "unknown"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "family",
                  "count"
                ],
                "additionalProperties": false
              },
              "maxItems": 8
            },
            "modelUsageUnit": {
              "type": "string",
              "enum": [
                "reported_tokens",
                "sessions",
                "unknown"
              ]
            },
            "mostUsedModelFamily": {
              "type": "string",
              "enum": [
                "openai",
                "anthropic",
                "google",
                "xai",
                "deepseek",
                "zai",
                "other",
                "unknown"
              ]
            },
            "mostUsedClient": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code",
                "antigravity",
                "cursor",
                "chatgpt",
                "other",
                "unknown"
              ]
            }
          },
          "required": [
            "humanSessions",
            "automatedSessions",
            "subagentSessions",
            "userMessages",
            "inputTokens",
            "outputTokens",
            "tokenSource",
            "modelUsage",
            "modelUsageUnit",
            "mostUsedModelFamily",
            "mostUsedClient"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^T(00[1-9]|01[0-9]|02[0-4])$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "source": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "antigravity",
                  "cursor",
                  "chatgpt",
                  "other",
                  "unknown"
                ]
              },
              "context": {
                "type": "string",
                "enum": [
                  "research",
                  "build",
                  "writing",
                  "planning",
                  "support",
                  "other"
                ]
              }
            },
            "required": [
              "id",
              "date",
              "source",
              "context"
            ],
            "additionalProperties": false
          },
          "maxItems": 24
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^O(00[1-9]|0[1-3][0-9]|04[0-8])$"
              },
              "task": {
                "type": "string",
                "pattern": "^T(00[1-9]|01[0-9]|02[0-4])$"
              },
              "behavior": {
                "type": "string",
                "enum": [
                  "collaborative_iteration",
                  "consolidated_delivery",
                  "concrete_evidence",
                  "pattern_exploration",
                  "consistent_criteria",
                  "people_context",
                  "early_commitment",
                  "reversible_experiments"
                ]
              },
              "ownerRequest": {
                "type": "string",
                "enum": [
                  "collaborative_iteration",
                  "consolidated_delivery",
                  "concrete_evidence",
                  "pattern_exploration",
                  "consistent_criteria",
                  "people_context",
                  "early_commitment",
                  "reversible_experiments",
                  "not_specified",
                  "unknown"
                ]
              },
              "opportunity": {
                "type": "string",
                "enum": [
                  "both_available",
                  "constrained",
                  "unclear"
                ]
              }
            },
            "required": [
              "id",
              "task",
              "behavior",
              "ownerRequest",
              "opportunity"
            ],
            "additionalProperties": false
          },
          "maxItems": 48
        },
        "assessment": {
          "type": "object",
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "INTJ",
                    "INTP",
                    "ENTJ",
                    "ENTP",
                    "INFJ",
                    "INFP",
                    "ENFJ",
                    "ENFP",
                    "ISTJ",
                    "ISFJ",
                    "ESTJ",
                    "ESFJ",
                    "ISTP",
                    "ISFP",
                    "ESTP",
                    "ESFP"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "pattern": {
              "type": "string",
              "pattern": "^[EI?][SN?][TF?][JP?]$"
            },
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "incomplete"
              ]
            }
          },
          "required": [
            "type",
            "pattern",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "kind",
        "nickname",
        "consent",
        "observedPeriod",
        "coverage",
        "metrics",
        "tasks",
        "observations",
        "assessment"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
