{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-mbti",
  "account_id": "7910ab8eac2e72cc2c36430f438df708",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-mbti",
      // TODO(owner): run `npx wrangler d1 create agent-mbti` and paste the returned database_id here.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-IP limits keyed by CF-Connecting-IP. namespace_id is any account-unique integer string.
  "ratelimits": [
    { "name": "SESSION_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // TODO(owner): replace with the site key of the Turnstile widget created for the workers.dev hostname.
    // This default is Cloudflare's always-pass test key; a real secret rejects its tokens, so a forgotten swap fails closed.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  }
}
