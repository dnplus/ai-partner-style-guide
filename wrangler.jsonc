{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-mbti",
  "account_id": "7910ab8eac2e72cc2c36430f438df708",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  // The site lives on its own domain; workers.dev stays on so old links reach proxy.ts and get redirected.
  "workers_dev": true,
  "routes": [{ "pattern": "urai.dnplus.dev", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-mbti",
      "database_id": "cbabbf9b-bae0-4d38-b1e7-543d13b4790e",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-IP limits keyed by CF-Connecting-IP. namespace_id is any account-unique integer string.
  "ratelimits": [
    { "name": "SESSION_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Cloudflare's always-pass test key for local dev; `npm run deploy` passes the production key,
    // whose widget allows urai.dnplus.dev and agent-mbti.dnplus.workers.dev.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  }
}
